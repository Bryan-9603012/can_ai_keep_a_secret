# Copy this file to .env and fill in values locally.
# Never commit real API keys.

DEFAULT_MODEL=mock
TEMPERATURE=0
MAX_TOKENS=300

# Local Ollama endpoint.
OLLAMA_URL=http://127.0.0.1:11434

# Cloud OpenAI-compatible endpoint.
# Keep the actual key in OPENAI_API_KEY, not in experiment JSON/CSV.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
CLOUD_MODEL=gpt-4.1-mini

# Optional: Google Sheets report sync.
# Create a Google Cloud service account key JSON, then share the target Google Sheet
# with the service account email as Editor.
GOOGLE_SHEETS_SPREADSHEET_ID=1oSQ5SqSVDjNxam7SR7R2VHovcnIaQfsCQMZNsJeczXM
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GOOGLE_SHEETS_REPORT_DIR=
